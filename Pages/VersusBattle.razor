@page "/versus_battle"
@inject NavigationManager NavigationManager
@inject DataServiceFactory ServiceFactory

@inject IJSRuntime JS
@inject IToastService toastService

@using WayfinderProject.Domain
@using WayfinderProject.Domain.Factories
@using WayfinderProject.Domain.Models
@using WayfinderProject.Domain.Models.Filters.JiminyJournal
@using WayfinderProject.Domain.Models.JiminyJournal
@using WayfinderProject.Services.JiminyJournal

<PageTitle>The Wayfinder Project - Versus Battle</PageTitle>

<br />
<br />

<div class="wayfinder-background">
    <div class="wayfinder-parallax">

        @if (!this.IsMobile)
        {
            <div class="row" style="width: 100%; margin: 0px 0px 30px 0px">
                <div class="col-md-12" style="align-self: center;">
                    <div class="wayfinder-title">
                        <img src="images/wayfinder_project_title.png" />
                    </div>
                </div>
            </div>

            <hr />

            <div class="row" style="width: 100%; margin: 0px 0px 30px 0px">
                <div class="col-md-1"></div>

                <div class="col-md-4" style="text-align: center;">
                    <div class="wayfinder-title">
                        <strong><span style="color: #522aff;">Battle of the Day</span></strong>
                    </div>

                    <div class="wayfinder-alt-description">
                        <strong>
                            Discover a brand new daily versus battle by visiting The Wayfinder Project everyday! Follow <a href="https://twitter.com/WFP_KH" target="_blank">@@WFP_KH on Twitter</a>!
                        </strong>
                    </div>

                    <br />

                    <button class="wayfinder-button" onclick="@(() => this.NavigateToDailyBattle())" @onclick:stopPropagation>Daily Battle</button>
                </div>

                <div class="col-md-2"></div>

                @if (this.IsMobile)
                {
                    <span style="margin-bottom: 25px;"></span>
                }

                <div class="col-md-4" style="text-align: center;">
                    <div class="wayfinder-title">
                        <strong>
                            <span style="color: #ea4a4a;">Random</span>
                            <span style="color: #2cce78;">Battle</span>
                            <span style="color: #5499fc;">Gen</span>
                        </strong>
                    </div>

                    <div class="wayfinder-alt-description">
                        <strong>
                            Generate a random versus battle right now!
                        </strong>
                    </div>

                    <br />

                    <button class="wayfinder-button" onclick="@(() => this.NavigateToRandomBattle())" @onclick:stopPropagation>Random Battle</button>
                </div>

                <div class="col-md-1"></div>
            </div>
        }
    </div>
</div>

@if (Loading)
{
    <div class="row justify-content-center"><div class="spinner col-md-12"></div></div>
}
else
{
    @if (FirstCombatant == null || SecondCombatant == null || string.IsNullOrWhiteSpace(FirstCombatant.Name) || string.IsNullOrWhiteSpace(SecondCombatant.Name))
    {
        <div class="row justify-content-center"><div class="col-md-12" style="text-align:center; margin-top: 25px; margin-bottom: 50px;">
            <p>Select "Daily Battle" or "Random Battle" to generate a versus match.</p>
        </div></div>
    }
    else
    {
        <div class="row" style="margin-top: 25px; margin-bottom: 50px; align-items: center;">
            <div class="col-md-5">
                <div style="margin-top:20px; text-align:center;">
                    @if (!string.IsNullOrEmpty(FirstCombatant.ImageLink))
                    {
                        <img class="image-container" src="@(FirstCombatant.ImageLink)" />
                    }
                    else
                    {
                        <img class="image-container" src="images/JJ.png" />
                    }
                </div>

                <div class="expansion-content-card">
                    <div class="details-pane">
                        <h3>@FirstCombatant.Name</h3>

                        <div class="mt-3">
                            <h5>
                                <img src="images/icons/game_hearts/@(Utilities.GetCodeForGame(FirstCombatant.Game)).png" class="info-detail-icon" /> @FirstCombatant.Game
                            </h5>
                        </div>

                        <div class="mt-4">
                            <h3>Information</h3>
                            <label class="font-weight-700">@FirstCombatant.Description</label>
                        </div>

                        @if (!string.IsNullOrEmpty(FirstCombatant.AdditionalInformation))
                        {
                            <div class="mt-4">
                                <label class="font-weight-700">@FirstCombatant.AdditionalInformation</label>
                            </div>
                        }

                        <div class="mt-3">
                            <h4 class="world-color"><img src="images/icons/worlds.png" class="detail-icon" /> Worlds</h4>
                            <label>@string.Join(", ", FirstCombatant.Worlds)</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-2 text-center">
                <div style="display:flex; align-items:center; justify-content:center; height:100%;">
                    <div>
                        <img src="images/versus.png" style="max-width:120px;" />
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div style="margin-top:10px; text-align:center;">
                    @if (!string.IsNullOrEmpty(SecondCombatant.ImageLink))
                    {
                        <img class="image-container" src="@(SecondCombatant.ImageLink)" />
                    }
                    else
                    {
                        <img class="image-container" src="images/JJ.png" />
                    }
                </div>

                <div class="expansion-content-card">
                    <div class="details-pane">
                        <h3>@SecondCombatant.Name</h3>

                        <div class="mt-3">
                            <h5>
                                <img src="images/icons/game_hearts/@(Utilities.GetCodeForGame(SecondCombatant.Game)).png" class="info-detail-icon" /> @SecondCombatant.Game
                            </h5>
                        </div>

                        <div class="mt-4">
                            <h3>Information</h3>
                            <label class="font-weight-700">@SecondCombatant.Description</label>
                        </div>

                        @if (!string.IsNullOrEmpty(SecondCombatant.AdditionalInformation))
                        {
                            <div class="mt-4">
                                <label class="font-weight-700">@SecondCombatant.AdditionalInformation</label>
                            </div>
                        }

                        <div class="mt-3">
                            <h4 class="world-color"><img src="images/icons/worlds.png" class="detail-icon" /> Worlds</h4>
                            <label>@string.Join(", ", SecondCombatant.Worlds)</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    public bool Loading { get; set; }
    public bool IsMobile { get; set; }

    public string CurrentViewMobile { get; set; } = "Available";

    public EnemyEntryService? EnemyEntryService;
    public CharacterEntryService? CharacterEntryService;

    private IEnumerable<object> CurrentResults = new List<object>();

    private BaseJiminyJournalData FirstCombatant { get; set; } = new();
    private BaseJiminyJournalData SecondCombatant { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Loading = true;

        await Task.Yield();

        var characterEntryService = ServiceFactory.CreateAsync<CharacterEntryService, CharacterEntry, CharacterEntryCriteria, CharacterEntryWrapper<CharacterEntry>>(Constants.CharacterEntriesPath);
        var enemyEntryService = ServiceFactory.CreateAsync<EnemyEntryService, EnemyEntry, EnemyEntryCriteria, EnemyEntryWrapper<EnemyEntry>>(Constants.EnemyEntriesPath);

        await Task.WhenAll(characterEntryService, enemyEntryService);

        CharacterEntryService = characterEntryService.Result;
        EnemyEntryService = enemyEntryService.Result;

        Loading = false;
    }

    private async Task NavigateToRandomBattle()
    {
        // Random-ness is handled within the Service
        await NavigateToBattle();
    }

    private async Task NavigateToDailyBattle()
    {
        var seed = DateTime.UtcNow.ToShortDateString();
        var seed1 = seed + "_1";
        var seed2 = seed + "_2";
        await NavigateToBattle(seed1, seed2);
    }


    private IEnumerable<BaseJiminyJournalData> GetAllCombatants()
    {
        var combatants = new List<BaseJiminyJournalData>();

        if (CharacterEntryService != null)
        {
            combatants.AddRange(CharacterEntryService.GetAllData().Cast<BaseJiminyJournalData>());
        }

        if (EnemyEntryService != null)
        {
            combatants.AddRange(EnemyEntryService.GetAllData().Cast<BaseJiminyJournalData>());
        }

        return combatants;
    }

    private BaseJiminyJournalData GetRandomCombatant(string seed, IEnumerable<BaseJiminyJournalData>? exclusions = null)
    {
        var pool = GetAllCombatants()
            .Where(entry => exclusions == null || !exclusions.Any(excluded => excluded.Name == entry.Name && excluded.Game == entry.Game))
            .ToList();

        if (!pool.Any())
        {
            return new BaseJiminyJournalData();
        }

        var random = string.IsNullOrWhiteSpace(seed)
            ? new Random()
            : new Random(Utilities.Hash(seed));

        return pool[random.Next(pool.Count)];
    }

    private async Task NavigateToBattle(string seed1 = "", string seed2 = "")
    {
        if (CharacterEntryService == null || EnemyEntryService == null) return;

        var result1 = GetRandomCombatant(seed1);
        var result2 = GetRandomCombatant(seed2, [result1]);

        if (result1.Name == result2.Name && result1.Game == result2.Game)
        {
            result2 = GetRandomCombatant(seed2, [result1, result2]);
        }

        FirstCombatant = result1;
        SecondCombatant = result2;

        StateHasChanged();
    }
}